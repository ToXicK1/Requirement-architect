# Copy to .env and fill in. Never commit .env.
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./requirements_architect.db
# Production example: postgresql+asyncpg://user:password@db:5432/requirements_architect
SECRET_KEY=                         # REQUIRED in production, min 32 chars
# LLM provider config is added in Phase 2 (LLM_PROVIDER, LLM_API_KEY, ...)
