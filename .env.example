# Copy to .env and fill in. Never commit .env.
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./requirements_architect.db
# Production example: postgresql+asyncpg://user:password@db:5432/requirements_architect
SECRET_KEY=                         # REQUIRED in production, min 32 chars


# --- LLM gateway ---
LLM_PROVIDER=                       # anthropic | openai_compat (blank = LLM features disabled in dev)
LLM_API_KEY=
LLM_MODEL=                          # no default: choose a model your account can use
# LLM_BASE_URL=                     # optional override (e.g. an OpenAI-compatible gateway)
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=4
# Operator-supplied prices; unknown models are reported as cost-unknown, never guessed.
LLM_PRICE_TABLE_JSON={}

# --- Research (Stage 3); all optional ---
RESEARCH_ENABLED=true
BRAVE_API_KEY=                      # enables web search; without it only GitHub/PyPI/npm/OSV are used
GITHUB_TOKEN=                       # optional; raises GitHub API rate limits
RESEARCH_ALLOW_HTTP=false           # plain http fetches are refused unless true
RESEARCH_MAX_FETCHES=10
RESEARCH_FETCH_TIMEOUT_SECONDS=15
RESEARCH_FETCH_MAX_BYTES=2000000
OUTPUT_DIR=./data/output
